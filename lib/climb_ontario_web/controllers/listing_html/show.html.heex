<Layouts.app flash={@flash}>
  <article class="pt-3 sm:pt-8">
    <a href="/" class="text-sm link link-hover text-base-content/70">← All listings</a>

    <div :if={past?(@listing, @today)} class="mt-4 rounded-box bg-base-200 p-3 text-sm">
      This has already happened. <a href="/" class="link">See what's coming up.</a>
    </div>
    <div :if={@listing.status == "cancelled"} class="mt-4 rounded-box bg-error/10 p-3 text-sm">
      This listing was cancelled by the organizer.
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      <.kind_badge listing={@listing} />
      <span :if={@listing.confidence == "tentative"} class="tag tag-muted">Tentative</span>
      <span :if={@listing.registration_state == "full"} class="tag tag-muted">Full</span>
      <span :if={@listing.registration_state == "opens_later"} class="tag tag-muted">Registration opens later</span>
    </div>
    <h1 class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-balance">
      {@listing.title}
    </h1>
    <p class="mt-1 text-base-content/70">
      {Format.venue_line(@listing.venue)}
      <span :if={@listing.venue_note == nil}>
        ·
        <a href={maps_url(@listing.venue)} target="_blank" rel="noopener" class="link link-hover">Map ↗</a>
      </span>
    </p>
    <p
      :if={@listing.venue_note}
      class="mt-1 text-sm text-warning-content bg-warning/20 rounded px-2 py-1 inline-block"
    >
      {@listing.venue_note}
    </p>

    <dl class="mt-5 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm rounded-box border border-base-300 bg-base-100 p-4">
      <dt class="text-base-content/60">When</dt>
      <dd>
        <span class="font-medium">{Format.when_line(@listing, @today)}</span>
        <span :if={@listing.schedule_note} class="block text-base-content/80">{@listing.schedule_note}</span>
      </dd>
      <dt class="text-base-content/60">Price</dt>
      <dd>{Format.price(@listing) || "Not published"}</dd>
      <dt :if={@listing.ages || @listing.audience != []} class="text-base-content/60">Who</dt>
      <dd :if={@listing.ages || @listing.audience != []}>
        {[@listing.ages | Enum.map(@listing.audience, &Format.audience_label/1)]
        |> Enum.reject(&is_nil/1)
        |> Enum.join(" · ")}<span :if={@listing.skill == "beginner"}> · beginner friendly</span>
      </dd>
    </dl>

    <p :if={@listing.summary != ""} class="mt-5 text-base leading-relaxed">{@listing.summary}</p>

    <div :if={@listing.caveat} class="mt-4 flex gap-2 rounded-box bg-warning/15 p-3 text-sm">
      <.icon name="hero-exclamation-triangle" class="size-5 shrink-0 text-warning" />
      <span>{@listing.caveat}</span>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <a
        :if={@listing.organizer_url}
        href={@listing.organizer_url}
        target="_blank"
        rel="noopener"
        class="btn btn-primary rounded-field"
      >
        {Format.link_label(@listing.link_kind)} ↗
      </a>
      <button
        type="button"
        id="copy-link"
        phx-hook="CopyLink"
        data-url={@meta.url}
        data-title={@listing.title}
        class="btn rounded-field"
      >
        <.icon name="hero-link" class="size-5" /> <span data-label>Copy link</span>
      </button>
    </div>
    <p :if={@listing.link_kind == "gym"} class="mt-2 text-xs text-base-content/60">
      No page for this event was found; the gym's website is the best place to ask.
    </p>

    <details
      :if={
        (@listing.details && @listing.details != @listing.summary) || @listing.price_text ||
          @listing.recurrence_text
      }
      class="mt-6 rounded-box border border-base-300 p-4 text-sm"
    >
      <summary class="cursor-pointer font-medium">Full schedule and pricing as published</summary>
      <p
        :if={@listing.details && @listing.details != @listing.summary}
        class="mt-2 whitespace-pre-line text-base-content/80"
      >
        {@listing.details}
      </p>
      <p :if={@listing.recurrence_text} class="mt-2 text-base-content/80">
        <span class="font-medium">Schedule:</span> {@listing.recurrence_text}
      </p>
      <p :if={@listing.price_text} class="mt-2 text-base-content/80">
        <span class="font-medium">Price:</span> {@listing.price_text}
      </p>
    </details>

    <div class="mt-8 text-xs text-base-content/60 space-y-1">
      <p>
        Checked {Format.checked(@listing.checked_at)} against the organizer's published information. Things change; confirm before you go.
      </p>
      <p :if={@listing.source_urls != []}>
        Sources:
        <span :for={{u, i} <- Enum.with_index(@listing.source_urls)}><span :if={i > 0}>, </span><a
          href={u}
          target="_blank"
          rel="noopener"
          class="link"
        >{host(u)}</a></span>
      </p>
    </div>
  </article>
</Layouts.app>
