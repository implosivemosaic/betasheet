<Layouts.app flash={@flash}>
  <section class="pt-6 sm:pt-12 flex flex-col sm:flex-row items-center gap-8">
    <div id="climber-hero" class="climber-hero shrink-0" aria-hidden="true"></div>
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-base-content/60">404</p>
      <h1 class="mt-1 text-3xl sm:text-4xl font-extrabold tracking-tight text-balance leading-[1.05]">
        This route doesn't go anywhere.
      </h1>
      <p class="mt-3 text-base leading-relaxed text-base-content/70">
        The page you're after may have moved, or the event may have come and gone. Our climber is still looking.
      </p>
      <a href="/" class="btn btn-primary rounded-field mt-5">See what's on</a>
    </div>
  </section>
</Layouts.app>
